<Window x:Class="Nodify_ETLBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nodify_ETLBox"
        xmlns:vm="clr-namespace:EtlDesigner.UI.ViewModels"
        mc:Ignorable="d"
        Title="Data Flow ETL Designer"
        Height="700"
        Width="1200">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Resources/NodeTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Height="40">
            <Button x:Name="RunButton" Content="Run" Width="60" Command="{Binding Editor.ValidateCommand}" />
            <Separator />
            <Button x:Name="SampleButton" Content="Sample" Width="60" Command="{Binding Editor.LoadSampleGraphCommand}" />
            <Separator />
            <Label Content="Theme" />
            <ComboBox x:Name="ThemeSelector" Width="100" SelectionChanged="ThemeSelector_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
        </ToolBar>

        <!-- Main layout: Left palette | Center editor | Right settings -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <!-- Left Palette -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="#F5F5F5" Margin="0,0,1,0">
                <TextBlock Text="Node Types" FontWeight="Bold" Margin="4,4,4,8" />
                <Button x:Name="CsvSourceBtn" Content="CsvSource" Margin="4,2" Padding="4" Click="PaletteButton_Click" Tag="CsvSource" />
                <Button x:Name="FilterbyCountryBtn" Content="Filter" Margin="4,2" Padding="4" Click="PaletteButton_Click" Tag="FilterByCountry" />
                <Button x:Name="ToJsonBtn" Content="ToJson" Margin="4,2" Padding="4" Click="PaletteButton_Click" Tag="ToJson" />
                <Button x:Name="ParseJsonBtn" Content="ParseJson" Margin="4,2" Padding="4" Click="PaletteButton_Click" Tag="ParseJson" />
                <Button x:Name="ResultJsonBtn" Content="ResultJson" Margin="4,2" Padding="4" Click="PaletteButton_Click" Tag="ResultJson" />
            </StackPanel>

            <!-- Center Editor - NodifyEditor -->
            <ScrollViewer Grid.Row="0" Grid.Column="1" CanContentScroll="True">
                <nodify:NodifyEditor x:Name="EditorControl"
                                     ItemsSource="{Binding Editor.Nodes}"
                                     SelectedItem="{Binding Editor.SelectedNode}"
                                     SelectedItems="{Binding Editor.SelectedNodes}"
                                     Connections="{Binding Editor.Connections}"
                                     PendingConnection="{Binding Editor.PendingConnection}"
                                     DisconnectConnectorCommand="{Binding Editor.DeleteSelectedCommand}"
                                     ConnectionCompletedCommand="{Binding Editor.CreateConnectionCommand}">
                    <!-- Pending Connection Template -->
                    <nodify:NodifyEditor.PendingConnectionTemplate>
                        <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                            <nodify:PendingConnection Source="{Binding Source, Mode=OneWayToSource}"
                                                      Target="{Binding Target, Mode=OneWayToSource}"
                                                      EnablePreview="True">
                                <nodify:PendingConnection.Template>
                                    <ControlTemplate TargetType="{x:Type nodify:PendingConnection}">
                                        <nodify:LineConnection Source="{TemplateBinding SourceAnchor}"
                                                               Target="{TemplateBinding TargetAnchor}"
                                                               StrokeThickness="{TemplateBinding StrokeThickness}"
                                                               Stroke="{TemplateBinding Stroke}" />
                                    </ControlTemplate>
                                </nodify:PendingConnection.Template>
                            </nodify:PendingConnection>
                        </DataTemplate>
                    </nodify:NodifyEditor.PendingConnectionTemplate>

                    <!-- Connection Template -->
                    <nodify:NodifyEditor.ConnectionTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                            <nodify:LineConnection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}"
                                                   StrokeThickness="2"
                                                   Stroke="#333" />
                        </DataTemplate>
                    </nodify:NodifyEditor.ConnectionTemplate>

                    <!-- Item Template (Node) -->
                    <nodify:NodifyEditor.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                            <nodify:StateNode Content="{Binding}"
                                              IsConnected="True"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                <nodify:StateNode.ContentTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                        <StackPanel Orientation="Vertical" Margin="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,4" FontSize="12" />
                                            <TextBlock Text="{Binding State}" FontSize="10" Foreground="#666" />
                                        </StackPanel>
                                    </DataTemplate>
                                </nodify:StateNode.ContentTemplate>
                            </nodify:StateNode>
                        </DataTemplate>
                    </nodify:NodifyEditor.ItemTemplate>

                    <!-- Item Container Style -->
                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}">
                            <Setter Property="Location" Value="{Binding Location}" />
                            <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}" />
                        </Style>
                    </nodify:NodifyEditor.ItemContainerStyle>

                    <!-- Delete Key Binding -->
                    <nodify:NodifyEditor.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding Editor.DeleteSelectedCommand}" />
                    </nodify:NodifyEditor.InputBindings>
                </nodify:NodifyEditor>
            </ScrollViewer>

            <!-- Right Settings Panel -->
            <StackPanel Grid.Row="0" Grid.Column="2" Background="#F0F0F0" Margin="1,0,0,0">
                <TextBlock Text="Settings" FontWeight="Bold" Margin="4,4,4,8" />
                <ScrollViewer Margin="4">
                    <StackPanel x:Name="SettingsPanel">
                        <TextBlock Text="Select a node" Foreground="Gray" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Bottom TabControl for Issues and Output -->
            <TabControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,1,0,0">
                <TabItem Header="Issues">
                    <ListBox x:Name="IssuesListBox" ItemsSource="{Binding Editor.Issues}" Margin="4" />
                </TabItem>
                <TabItem Header="Filtered JSON">
                    <TextBox x:Name="FilteredJsonOutput" Text="{Binding FilteredJsonOutput}" Margin="4" IsReadOnly="True" FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Foreground="#333" Background="#FFF" />
                </TabItem>
                <TabItem Header="Parsed JSON">
                    <TextBox x:Name="ParsedJsonOutput" Text="{Binding ParsedJsonOutput}" Margin="4" IsReadOnly="True" FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Foreground="#333" Background="#FFF" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
