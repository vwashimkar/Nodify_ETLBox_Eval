<Window x:Class="Nodify_ETLBox.UI.GenerateDllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate DLL"
        Width="760"
        Height="640"
        MinWidth="600"
        MinHeight="520"
        ResizeMode="CanResize"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- A validation message under a field; hidden while its Text is null. -->
            <Style x:Key="FieldError" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource error-brush}" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource text-muted-brush}" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Shows only while there is something in the list it shows. -->
            <Style x:Key="ListPanel" TargetType="Border">
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Setter Property="Padding" Value="{DynamicResource Thickness8}" />
                <Setter Property="Background" Value="{DynamicResource surface-alt-brush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource error-brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Messages.Count, Mode=OneWay}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Thickness16}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Names and folder -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Assembly name" Style="{StaticResource Label}" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AssemblyName, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource font-data}" VerticalContentAlignment="Center" Margin="{DynamicResource Thickness4}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AssemblyNameError, Mode=OneWay, TargetNullValue=''}" Style="{StaticResource FieldError}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Namespace" Style="{StaticResource Label}" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Namespace, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource font-data}" VerticalContentAlignment="Center" Margin="{DynamicResource Thickness4}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding NamespaceError, Mode=OneWay, TargetNullValue=''}" Style="{StaticResource FieldError}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Output folder" Style="{StaticResource Label}" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource font-data}" VerticalContentAlignment="Center" Margin="{DynamicResource Thickness4}" />
            <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                    Command="{Binding BrowseCommand}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OutputFolderError, Mode=OneWay, TargetNullValue=''}" Style="{StaticResource FieldError}" />
        </Grid>

        <!-- What will be baked -->
        <Border Grid.Row="1" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" Background="{DynamicResource surface-alt-brush}">
            <StackPanel>
                <TextBlock Text="Settings baked into the DLL" FontWeight="SemiBold" Margin="{DynamicResource Thickness4}" />
                <ItemsControl ItemsSource="{Binding Summary, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneWay}" FontFamily="{DynamicResource font-data}" TextWrapping="Wrap" Margin="{DynamicResource Thickness4}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Generate -->
        <DockPanel Grid.Row="2" Margin="{DynamicResource Thickness4}">
            <Button DockPanel.Dock="Left" Content="Generate" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                    Command="{Binding GenerateCommand}" IsDefault="True" />
            <Button DockPanel.Dock="Left" Content="Copy usage example" Width="160" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                    Command="{Binding CopyUsageCommand}" />
            <ProgressBar IsIndeterminate="True" Width="160" HorizontalAlignment="Left" Margin="{DynamicResource Thickness8}"
                         Visibility="{Binding IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <!-- Result -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource Thickness4}">
            <StackPanel>
                <Border Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" Background="{DynamicResource surface-alt-brush}"
                        BorderBrush="{DynamicResource success-brush}" BorderThickness="1"
                        Visibility="{Binding Succeeded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="The DLL was generated." FontWeight="SemiBold" Margin="{DynamicResource Thickness4}" />
                        <TextBlock Text="DLL" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding DllPath, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource font-data}" Margin="{DynamicResource Thickness4}" />
                        <TextBlock Text="README" Style="{StaticResource MutedText}" />
                        <TextBox Text="{Binding ReadmePath, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource font-data}" Margin="{DynamicResource Thickness4}" />
                        <TextBlock Text="The consuming app needs the ETLBox and ETLBox.Csv 3.11.1 packages and its own ETLBox licence. See the README." Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ListPanel}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Messages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" Margin="{DynamicResource Thickness4}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid ItemsSource="{Binding CompileErrors, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" FontFamily="{DynamicResource font-data}" Margin="{DynamicResource Thickness4}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding File, Mode=OneWay}" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line, Mode=OneWay}" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message, Mode=OneWay}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Thickness8}">
            <Button Content="Close" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
