<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="surface">#FF1F2229</Color>
    <Color x:Key="surface-alt">#FF2A2E36</Color>
    <Color x:Key="border">#FF3B4352</Color>
    <Color x:Key="text">#FFF1F1F1</Color>
    <Color x:Key="text-muted">#FFB8C1D1</Color>
    <Color x:Key="accent">#FF1E88E5</Color>
    <Color x:Key="accent-soft">#331E88E5</Color>
    <Color x:Key="success">#FF8DD28A</Color>
    <Color x:Key="warning">#FFE6AF86</Color>
    <Color x:Key="error">#FFFF8A80</Color>
    <Color x:Key="canvas">#FF2D2D30</Color>

    <SolidColorBrush x:Key="surface-brush" Color="{DynamicResource surface}" />
    <SolidColorBrush x:Key="surface-alt-brush" Color="{DynamicResource surface-alt}" />
    <SolidColorBrush x:Key="border-brush" Color="{DynamicResource border}" />
    <SolidColorBrush x:Key="text-brush" Color="{DynamicResource text}" />
    <SolidColorBrush x:Key="text-muted-brush" Color="{DynamicResource text-muted}" />
    <SolidColorBrush x:Key="accent-brush" Color="{DynamicResource accent}" />
    <SolidColorBrush x:Key="accent-soft-brush" Color="{DynamicResource accent-soft}" />
    <SolidColorBrush x:Key="success-brush" Color="{DynamicResource success}" />
    <SolidColorBrush x:Key="warning-brush" Color="{DynamicResource warning}" />
    <SolidColorBrush x:Key="error-brush" Color="{DynamicResource error}" />
    <SolidColorBrush x:Key="canvas-brush" Color="{DynamicResource canvas}" />

    <!-- Node card. Header and body text pairs are at least 4.5:1 contrast. -->
    <SolidColorBrush x:Key="NodeHeaderBackground" Color="#FF1A4F80" />
    <SolidColorBrush x:Key="NodeHeaderForeground" Color="#FFF1F1F1" />
    <SolidColorBrush x:Key="NodeBodyBackground" Color="#FF2A2E36" />
    <SolidColorBrush x:Key="NodeBodyForeground" Color="#FFF1F1F1" />

    <!-- Node footer by run state; footer text uses text-brush and text-muted-brush. -->
    <SolidColorBrush x:Key="NodeStateIdleBackground" Color="#FF353A44" />
    <SolidColorBrush x:Key="NodeStateRunningBackground" Color="#FF1F3A5C" />
    <SolidColorBrush x:Key="NodeStateSucceededBackground" Color="#FF1E4620" />
    <SolidColorBrush x:Key="NodeStateFailedBackground" Color="#FF5C1F1F" />
    <SolidColorBrush x:Key="NodeStateNotRunBackground" Color="#FF4A4020" />

    <!-- Dims a dialog while a long task runs. -->
    <SolidColorBrush x:Key="overlay-brush" Color="#66000000" />

    <sys:Double x:Key="spacing-4">4</sys:Double>
    <sys:Double x:Key="spacing-8">8</sys:Double>
    <sys:Double x:Key="spacing-12">12</sys:Double>
    <sys:Double x:Key="spacing-16">16</sys:Double>
    <sys:Double x:Key="spacing-24">24</sys:Double>
    <!-- Canvas node notes: the width a note line wraps at, and the most a status line may grow (four caption lines). -->
    <sys:Double x:Key="node-note-width">170</sys:Double>
    <sys:Double x:Key="node-status-max-height">60</sys:Double>

    <Thickness x:Key="Thickness4">4</Thickness>
    <Thickness x:Key="Thickness8">8</Thickness>
    <Thickness x:Key="Thickness12">12</Thickness>
    <Thickness x:Key="Thickness16">16</Thickness>
    <Thickness x:Key="Thickness24">24</Thickness>
    <!-- A compact list row: 4 left and right, 2 above and below. -->
    <Thickness x:Key="ThicknessListRow">4,2</Thickness>
    <!-- A placeholder text drawn over a box: in line with the box text. -->
    <Thickness x:Key="ThicknessPlaceholder">9,0,0,0</Thickness>

    <CornerRadius x:Key="corner-radius">4</CornerRadius>

    <sys:Double x:Key="font-caption">11</sys:Double>
    <sys:Double x:Key="font-body">13</sys:Double>
    <sys:Double x:Key="font-title">16</sys:Double>

    <FontFamily x:Key="font-text">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="font-data">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>