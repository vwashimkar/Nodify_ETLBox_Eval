<Window x:Class="Nodify_ETLBox.UI.ParseValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParseValue settings"
        Width="560"
        Height="520"
        MinWidth="400"
        MinHeight="320"
        ResizeMode="CanResize"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">
    <!-- Placeholder until the ParseValue dialog is built: the node's settings as read-only JSON. -->
    <Border Padding="{DynamicResource Thickness16}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Current settings (read-only). The full ParseValue dialog comes in a later stage."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource text-muted-brush}"
                       Margin="{DynamicResource Thickness8}" />
            <Button DockPanel.Dock="Bottom"
                    Content="Close"
                    IsCancel="True"
                    IsDefault="True"
                    MinWidth="88"
                    HorizontalAlignment="Right"
                    Margin="{DynamicResource Thickness8}" />
            <TextBox Text="{Binding ParseValueSettingsText, Mode=OneWay}"
                     IsReadOnly="True"
                     Margin="{DynamicResource Thickness8}"
                     FontFamily="{DynamicResource font-data}"
                     Background="{DynamicResource surface-alt-brush}"
                     Foreground="{DynamicResource text-brush}"
                     BorderBrush="{DynamicResource border-brush}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
    </Border>
</Window>
