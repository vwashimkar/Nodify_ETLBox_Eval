<Window x:Class="Nodify_ETLBox.UI.ParseValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EtlDesigner.UI.Controls"
        xmlns:parsing="clr-namespace:EtlDesigner.Engine.Parsing"
        xmlns:vm="clr-namespace:EtlDesigner.UI.ViewModels"
        Title="ParseValue"
        Width="1250"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        ResizeMode="CanResize"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- A panel that shows only while its Tag (a message) is set. -->
            <Style x:Key="MessagePanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource surface-alt-brush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource error-brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="{DynamicResource Thickness8}" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Muted text that shows only while its Tag is 0 (an empty list's Count). -->
            <Style x:Key="EmptyText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource text-muted-brush}" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Setter Property="Padding" Value="{DynamicResource Thickness4}" />
                <Setter Property="MinWidth" Value="{DynamicResource spacing-24}" />
            </Style>

            <!-- A reject or flagged line: clicking it selects the record's row in the sample grid. -->
            <Style x:Key="RecordLink" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource accent-brush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{DynamicResource Thickness4}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RecordIssueTemplate" DataType="{x:Type parsing:RecordIssue}">
                <Button Style="{StaticResource RecordLink}"
                        Command="{Binding DataContext.SelectRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Record" />
                        <Run Text="{Binding RecordNumber, Mode=OneWay}" />
                        <Run Text=": " />
                        <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{DynamicResource text-brush}" />
                    </TextBlock>
                </Button>
            </DataTemplate>

            <!-- Colours of the selected cell's pieces (ParseStudioViewModel.HighlightSegments). -->
            <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type vm:HighlightSegment}">
                <TextBlock x:Name="Piece" Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource text-brush}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Key">
                        <Setter TargetName="Piece" Property="Foreground" Value="{DynamicResource accent-brush}" />
                        <Setter TargetName="Piece" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Level1Delimiter">
                        <Setter TargetName="Piece" Property="Foreground" Value="{DynamicResource error-brush}" />
                        <Setter TargetName="Piece" Property="FontWeight" Value="Bold" />
                        <Setter TargetName="Piece" Property="Background" Value="{DynamicResource surface-alt-brush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Level2Delimiter">
                        <Setter TargetName="Piece" Property="Foreground" Value="{DynamicResource warning-brush}" />
                        <Setter TargetName="Piece" Property="FontWeight" Value="Bold" />
                        <Setter TargetName="Piece" Property="Background" Value="{DynamicResource surface-alt-brush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Level3Delimiter">
                        <Setter TargetName="Piece" Property="Foreground" Value="{DynamicResource success-brush}" />
                        <Setter TargetName="Piece" Property="FontWeight" Value="Bold" />
                        <Setter TargetName="Piece" Property="Background" Value="{DynamicResource surface-alt-brush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="SubPart">
                        <Setter TargetName="Piece" Property="Foreground" Value="{DynamicResource text-muted-brush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <x:Array x:Key="SplitModes" Type="parsing:SplitMode">
                <parsing:SplitMode>Once</parsing:SplitMode>
                <parsing:SplitMode>All</parsing:SplitMode>
                <parsing:SplitMode>Each</parsing:SplitMode>
            </x:Array>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Thickness16}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: node, file, status, messages ===== -->
        <Border Grid.Row="0" Background="{DynamicResource surface-alt-brush}" BorderBrush="{DynamicResource border-brush}" BorderThickness="1" Padding="{DynamicResource Thickness8}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource text-muted-brush}" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NodeTitle, Mode=OneWay}" FontSize="{DynamicResource font-title}" FontWeight="SemiBold" Margin="{DynamicResource Thickness4}" />
                        <TextBlock Text="File:" Foreground="{DynamicResource text-muted-brush}" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                        <TextBlock Text="{Binding FileName, Mode=OneWay}" FontFamily="{DynamicResource font-data}" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource MessagePanel}" Tag="{Binding GridMessage, Mode=OneWay}">
                    <TextBlock Text="{Binding GridMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource error-brush}" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== Centre: Data and Result tabs ===== -->
            <Grid Grid.Column="0" Margin="{DynamicResource Thickness8}">
                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="Data">
                        <Grid Margin="{DynamicResource Thickness8}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" MinHeight="160" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0">
                                <TextBlock Text="Source column" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                                <ComboBox Width="200" Margin="{DynamicResource Thickness4}" ItemsSource="{Binding Columns}" SelectedItem="{Binding SourceColumn, Mode=TwoWay}" />
                                <Button Content="Use as source" Style="{StaticResource SmallButton}" Command="{Binding UseAsSourceCommand}"
                                        ToolTip="Make the column of the selected cell the source column." />
                                <TextBlock Text="Select cells to choose slot columns. Ctrl+click or Shift+click selects more." VerticalAlignment="Center"
                                           Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                            </WrapPanel>

                            <DataGrid x:Name="SampleGrid"
                                      Grid.Row="1"
                                      Margin="{DynamicResource Thickness4}"
                                      ItemsSource="{Binding RowsView, Mode=OneWay}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserSortColumns="False"
                                      SelectionUnit="Cell"
                                      SelectionMode="Extended"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      HeadersVisibility="Column"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      FontFamily="{DynamicResource font-data}"
                                      controls:SampleGridBehavior.SelectionCommand="{Binding GridSelectionChangedCommand}"
                                      controls:SampleGridBehavior.SourceColumn="{Binding SourceColumn, Mode=OneWay}"
                                      controls:SampleGridBehavior.FocusRow="{Binding FocusRowIndex, Mode=OneWay}" />

                            <GridSplitter Grid.Row="2" Height="{DynamicResource spacing-4}" HorizontalAlignment="Stretch" Background="{DynamicResource border-brush}" />

                            <!-- Selected cell and the components of its row -->
                            <Grid Grid.Row="3" Margin="{DynamicResource Thickness4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">
                                        <Run Text="Selected cell" />
                                        <Run Text="{Binding DisplayedCellCaption, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource text-muted-brush}" />
                                    </TextBlock>
                                    <Border Background="{DynamicResource surface-alt-brush}" BorderBrush="{DynamicResource border-brush}" BorderThickness="1" Padding="{DynamicResource Thickness8}" Margin="{DynamicResource Thickness4}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding DisplayedCellSegments, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource SegmentTemplate}"
                                                          FontFamily="{DynamicResource font-data}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="Components of this row" Style="{StaticResource SectionTitle}" />
                                    <Border DockPanel.Dock="Top" Style="{StaticResource MessagePanel}" Tag="{Binding ComponentsError, Mode=OneWay}">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource error-brush}">
                                            <Run Text="This cell cannot be parsed:" />
                                            <Run Text="{Binding ComponentsError, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyText}" Tag="{Binding ComponentRows.Count, Mode=OneWay}"
                                               Text="Choose the source column and click a row to see its components." />
                                    <DataGrid ItemsSource="{Binding ComponentRows, Mode=OneWay}"
                                              Margin="{DynamicResource Thickness4}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              FontFamily="{DynamicResource font-data}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" />
                                            <DataGridTextColumn Header="Component" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                                            <DataGridTextColumn Header="Sub-parts" Binding="{Binding SubParts, Mode=OneWay}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Result">
                        <Grid Margin="{DynamicResource Thickness8}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.ColumnSpan="2" Text="{Binding ResultSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="{DynamicResource Thickness4}" />
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource MessagePanel}" Tag="{Binding TestError, Mode=OneWay}">
                                <TextBlock Text="{Binding TestError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource error-brush}" />
                            </Border>

                            <DataGrid Grid.Row="2"
                                      Margin="{DynamicResource Thickness4}"
                                      ItemsSource="{Binding ResultRowsView, Mode=OneWay}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      HeadersVisibility="Column"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      FontFamily="{DynamicResource font-data}" />

                            <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource Thickness4}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}">
                                        <Run Text="Rejects" />
                                        <Run Text="{Binding RowsRejected, Mode=OneWay}" Foreground="{DynamicResource text-muted-brush}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource EmptyText}" Tag="{Binding Rejects.Count, Mode=OneWay}" Text="No rejected rows." />
                                    <ItemsControl ItemsSource="{Binding Rejects}" ItemTemplate="{StaticResource RecordIssueTemplate}" />

                                    <TextBlock Style="{StaticResource SectionTitle}">
                                        <Run Text="Flagged" />
                                        <Run Text="{Binding RowsFlagged, Mode=OneWay}" Foreground="{DynamicResource text-muted-brush}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource EmptyText}" Tag="{Binding Flagged.Count, Mode=OneWay}" Text="No flagged rows." />
                                    <ItemsControl ItemsSource="{Binding Flagged}" ItemTemplate="{StaticResource RecordIssueTemplate}" />

                                    <TextBlock Text="Click a record to select its row in the Data tab (when it is among the preview rows)."
                                               TextWrapping="Wrap" Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Spinner while the preview loads; Cancel after half a second -->
                <Border Background="{DynamicResource overlay-brush}" Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource surface-alt-brush}" Padding="{DynamicResource Thickness16}">
                        <StackPanel>
                            <TextBlock Text="Loading preview..." FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="220" Margin="{DynamicResource Thickness8}" />
                            <Button Content="Cancel" Width="120" HorizontalAlignment="Center" Visibility="{Binding ShowCancelLoad, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Command="{Binding CancelLoadCommand}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="{DynamicResource spacing-4}" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="{DynamicResource border-brush}" />

            <!-- ===== Right: parsing settings ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="{DynamicResource Thickness8}">
                <StackPanel>
                    <!-- Delimiters -->
                    <GroupBox Header="Delimiters">
                        <StackPanel>
                            <TextBlock Text="Level 1 splits off the key (Once), level 2 splits the components (All), later levels split each component (Each)."
                                       TextWrapping="Wrap" Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                            <ItemsControl ItemsSource="{Binding DelimiterLevels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DelimiterLevelItem}">
                                        <!-- Line 1: delimiter, mode, Up, Down, Remove. Line 2 (Each only): the sub-part column. -->
                                        <StackPanel x:Name="DelimiterRow">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="88" Margin="{DynamicResource Thickness4}" FontFamily="{DynamicResource font-data}"
                                                         Text="{Binding Delimiter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Delimiter text" />
                                                <ComboBox Width="80" Margin="{DynamicResource Thickness4}" ItemsSource="{StaticResource SplitModes}"
                                                          SelectedItem="{Binding Mode, Mode=TwoWay}" ToolTip="Once, All or Each" />
                                                <Button Content="Up" Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.MoveLevelUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button Content="Down" Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.MoveLevelDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button Content="Remove" Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RemoveLevelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                            <StackPanel x:Name="SubPartLine" Orientation="Horizontal" Visibility="Collapsed">
                                                <TextBlock Text="Sub-part column" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                                                <TextBox Width="160" Margin="{DynamicResource Thickness4}" FontFamily="{DynamicResource font-data}"
                                                         Text="{Binding SubPartColumn, UpdateSourceTrigger=PropertyChanged}" ToolTip="Column name for the sub-part" />
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="Each">
                                                <Setter TargetName="SubPartLine" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="Add level" Style="{StaticResource SmallButton}" Command="{Binding AddLevelCommand}" />
                                <CheckBox Content="Trim" IsChecked="{Binding Trim, Mode=TwoWay}" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                                <CheckBox Content="Drop empty" IsChecked="{Binding DropEmpty, Mode=TwoWay}" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Slots -->
                    <GroupBox Header="Slots">
                        <StackPanel>
                            <TextBlock Text="Component 1 uses slot 1, component 2 uses slot 2, and so on. An empty slot is fine when records have fewer components."
                                       TextWrapping="Wrap" Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                            <TextBlock Style="{StaticResource EmptyText}" Tag="{Binding Slots.Count, Mode=OneWay}" Text="No slots. Press Add slot or use Auto-fill." />
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SlotItem}">
                                        <Border BorderBrush="{DynamicResource border-brush}" BorderThickness="0,0,0,1" Padding="{DynamicResource Thickness4}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBox DockPanel.Dock="Left" Width="56" Margin="{DynamicResource Thickness4}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Slot name" />
                                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ToggleButton x:Name="ColumnsToggle" DockPanel.Dock="Right" Content="Columns" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                                                                  ToolTip="Tick the columns of this slot" />
                                                    <Button DockPanel.Dock="Right" Content="Use grid selection" Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.UseGridSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="Use the columns of the selected grid cells, in file order" />
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle, Mode=TwoWay}" StaysOpen="False"
                                                           PlacementTarget="{Binding ElementName=ColumnsToggle}" Placement="Bottom" AllowsTransparency="True">
                                                        <Border Background="{DynamicResource surface-brush}" BorderBrush="{DynamicResource border-brush}" BorderThickness="1" Padding="{DynamicResource Thickness8}">
                                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding Choices}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:ColumnChoice}">
                                                                            <CheckBox Content="{Binding Name, Mode=OneWay}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="{DynamicResource Thickness4}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                    <Border />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource EmptyText}" Tag="{Binding Columns.Count, Mode=OneWay}" Text="No columns yet." />
                                                <ItemsControl ItemsSource="{Binding Columns}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource accent-soft-brush}" BorderBrush="{DynamicResource accent-brush}" BorderThickness="1"
                                                                    CornerRadius="{DynamicResource corner-radius}" Padding="{DynamicResource Thickness4}" Margin="{DynamicResource Thickness4}">
                                                                <TextBlock Text="{Binding Mode=OneWay}" FontFamily="{DynamicResource font-data}" Foreground="{DynamicResource text-brush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add slot" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Command="{Binding AddSlotCommand}" />

                            <Border BorderBrush="{DynamicResource border-brush}" BorderThickness="1" Padding="{DynamicResource Thickness8}" Margin="{DynamicResource Thickness4}">
                                <StackPanel>
                                    <TextBlock Text="Auto-fill" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Cuts the columns selected in the grid (or all kept columns except the source when none are selected) into slots of this size. Every slot stays editable."
                                               TextWrapping="Wrap" Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                                    <WrapPanel>
                                        <TextBlock Text="Group size" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                                        <TextBox Width="48" Margin="{DynamicResource Thickness4}" Text="{Binding AutoFillGroupSize, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Auto-fill" Style="{StaticResource SmallButton}" Command="{Binding AutoFillCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding AutoFillError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource error-brush}" Margin="{DynamicResource Thickness4}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- Rules -->
                    <GroupBox Header="Rules">
                        <StackPanel>
                            <TextBlock Text="More components than slots" Margin="{DynamicResource Thickness4}" />
                            <ComboBox Margin="{DynamicResource Thickness4}" SelectedValuePath="Tag" SelectedValue="{Binding ExcessPolicy, Mode=TwoWay}">
                                <ComboBoxItem Content="Reject the row" Tag="{x:Static parsing:ExcessPolicy.Reject}" />
                                <ComboBoxItem Content="Pair what fits and flag the row" Tag="{x:Static parsing:ExcessPolicy.PairWhatFits}" />
                            </ComboBox>

                            <TextBlock Text="Repeated component names in one row" Margin="{DynamicResource Thickness4}" />
                            <ComboBox Margin="{DynamicResource Thickness4}" SelectedValuePath="Tag" SelectedValue="{Binding DuplicatePolicy, Mode=TwoWay}">
                                <ComboBoxItem Content="Allow" Tag="{x:Static parsing:DuplicatePolicy.Allow}" />
                                <ComboBoxItem Content="Flag the row" Tag="{x:Static parsing:DuplicatePolicy.Flag}" />
                                <ComboBoxItem Content="Reject the row" Tag="{x:Static parsing:DuplicatePolicy.Reject}" />
                            </ComboBox>

                            <TextBlock Text="Carry columns (copied onto every output row)" Margin="{DynamicResource Thickness4}" />
                            <ComboBox Margin="{DynamicResource Thickness4}" SelectedValuePath="Tag" SelectedValue="{Binding CarryMode, Mode=TwoWay}">
                                <ComboBoxItem Content="All other columns" Tag="{x:Static vm:CarryChoice.All}" />
                                <ComboBoxItem Content="None" Tag="{x:Static vm:CarryChoice.None}" />
                                <ComboBoxItem Content="Choose columns" Tag="{x:Static vm:CarryChoice.List}" />
                            </ComboBox>
                            <Border BorderBrush="{DynamicResource border-brush}" BorderThickness="1" Padding="{DynamicResource Thickness4}" Margin="{DynamicResource Thickness4}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CarryMode}" Value="List">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EmptyText}" Tag="{Binding CarryChoices.Count, Mode=OneWay}" Text="The columns show here once the preview has loaded." />
                                    <ItemsControl ItemsSource="{Binding CarryChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ColumnChoice}">
                                                <CheckBox Content="{Binding Name, Mode=OneWay}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="{DynamicResource Thickness4}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Output shape" Margin="{DynamicResource Thickness4}" />
                            <ComboBox Margin="{DynamicResource Thickness4}" ItemsSource="{Binding OutputShapes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Shape" SelectedValue="{Binding OutputShape, Mode=TwoWay}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable, Mode=OneWay}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- Output schema -->
                    <GroupBox Header="Output schema">
                        <ItemsControl ItemsSource="{Binding OutputColumns}" Margin="{DynamicResource Thickness4}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay}" FontFamily="{DynamicResource font-data}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Bottom: unsaved-changes prompt, Test parsing, Save, Cancel ===== -->
        <DockPanel Grid.Row="2" Margin="{DynamicResource Thickness8}">
            <Button DockPanel.Dock="Left" Content="Test parsing" Width="120" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" Command="{Binding TestParsingCommand}" />
            <Button DockPanel.Dock="Right" Content="Cancel" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" Command="{Binding CancelCommand}" />
            <Button DockPanel.Dock="Right" Content="Save" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" Command="{Binding SaveCommand}" />
            <Border BorderBrush="{DynamicResource warning-brush}" BorderThickness="1" Background="{DynamicResource surface-alt-brush}" Padding="{DynamicResource Thickness4}" Margin="{DynamicResource Thickness4}"
                    HorizontalAlignment="Right" Visibility="{Binding ShowDiscardPrompt, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="You have unsaved changes. Discard them?" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    <Button Content="Discard" Style="{StaticResource SmallButton}" Command="{Binding DiscardCommand}" />
                    <Button Content="Keep editing" Style="{StaticResource SmallButton}" Command="{Binding KeepEditingCommand}" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
