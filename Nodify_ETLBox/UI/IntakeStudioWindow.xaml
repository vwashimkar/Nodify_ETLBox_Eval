<Window x:Class="Nodify_ETLBox.UI.IntakeStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EtlDesigner.UI.Controls"
        controls:LayoutUndoKeys.Undo="{Binding UndoCommand, Mode=OneWay}"
        controls:LayoutUndoKeys.Redo="{Binding RedoCommand, Mode=OneWay}"
        Title="Intake Studio"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="CanResize"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- A text that is hidden while its value is null. -->
            <Style x:Key="HiddenWhenNull" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A text line that is hidden while it has no text. -->
            <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A container row: compact, and a selection that shows in both themes with or without focus
                 (the Windows default greys an unfocused selection, nearly invisible in Dark). -->
            <Style x:Key="ContainerRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="{DynamicResource ThicknessListRow}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource surface-alt-brush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource accent-soft-brush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource accent-brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A Preview line: compact, and the clicked line highlighted with the same colours as a selected part. -->
            <Style x:Key="PreviewRow" TargetType="ListBoxItem" BasedOn="{StaticResource ContainerRow}">
                <Setter Property="Padding" Value="{DynamicResource ThicknessListRow}" />
            </Style>

            <!-- Edit tab: a disabled box looks disabled in both themes (the same opacity as a disabled button). -->
            <Style x:Key="EditCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="{DynamicResource ThicknessListRow}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="EditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="{DynamicResource ThicknessListRow}" />
                <Setter Property="Padding" Value="{DynamicResource ThicknessListRow}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="Foreground" Value="{DynamicResource text-muted-brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
                <Setter Property="Margin" Value="{DynamicResource ThicknessListRow}" />
                <Setter Property="Padding" Value="{DynamicResource ThicknessListRow}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="EditLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="{DynamicResource ThicknessListRow}" />
            </Style>
            <!-- The first label of an Edit row: one width, so the boxes of the rows line up. -->
            <Style x:Key="EditRowLabel" TargetType="TextBlock" BasedOn="{StaticResource EditLabel}">
                <Setter Property="Width" Value="72" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Esc cancels a running scan; with no scan it closes (asking about unsaved settings). -->
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand, Mode=OneWay}" />
    </Window.InputBindings>

    <Grid Margin="{DynamicResource Thickness8}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: file, mode, encoding, Scan, Cancel, progress ===== -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource border-brush}" BorderThickness="1"
                Background="{DynamicResource surface-alt-brush}" Padding="{DynamicResource Thickness8}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="File" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    <TextBlock Text="{Binding FileName, Mode=OneWay}" ToolTip="{Binding FileToolTip, Mode=OneWay}"
                               FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="100" MaxWidth="360"
                               TextTrimming="CharacterEllipsis" Margin="{DynamicResource Thickness4}" />
                    <Button x:Name="BrowseButton" Style="{StaticResource ThemedButton}" Content="Browse..." Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                            Command="{Binding BrowseCommand, Mode=OneWay}" />
                    <TextBlock Text="Mode" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    <ComboBox x:Name="ModeBox" Width="110" Margin="{DynamicResource Thickness4}" ItemsSource="{Binding Modes, Mode=OneWay}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode, Mode=TwoWay}"
                              AutomationProperties.Name="Mode" />
                    <TextBlock Text="Encoding" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    <ComboBox x:Name="EncodingBox" Width="230" Margin="{DynamicResource Thickness4}" ItemsSource="{Binding Encodings, Mode=OneWay}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Encoding, Mode=TwoWay}"
                              AutomationProperties.Name="Encoding" />
                    <Button x:Name="ScanButton" Style="{StaticResource ThemedButton}" Content="Scan" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}" MinWidth="72"
                            Command="{Binding ScanCommand, Mode=OneWay}" />
                    <Button x:Name="CancelButton" Style="{StaticResource ThemedButton}" Content="Cancel" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}" MinWidth="72"
                            Command="{Binding CancelCommand, Mode=OneWay}"
                            Visibility="{Binding IsCancelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <!-- Progress bar and its text on one line, so the top bar stays short at the minimum size. -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText, Mode=OneWay}" Foreground="{DynamicResource text-muted-brush}"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Margin="{DynamicResource Thickness4}" VerticalAlignment="Center"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Middle: containers (left) and details with preview (right) ===== -->
        <!-- The list starts 380 px wide (the Part column then shows about 14 characters at the minimum window size)
             and the splitter moves it; the list keeps at least 300 px and the tabs at least 360 px. -->
        <Grid x:Name="MiddleGrid" Grid.Row="1" Margin="{DynamicResource Thickness8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- The title comes first; when the list is narrow the layout buttons wrap under it, so they never take its space. -->
                <WrapPanel x:Name="ContainersTitleBar" DockPanel.Dock="Top">
                    <TextBlock x:Name="ContainersTitle" Text="Containers" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UndoButton" Style="{StaticResource ThemedButton}" Content="Undo" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource ThicknessListRow}"
                                Command="{Binding UndoCommand, Mode=OneWay}" ToolTip="Undo the last layout change (Ctrl+Z)" AutomationProperties.Name="Undo layout change" />
                        <Button x:Name="RedoButton" Style="{StaticResource ThemedButton}" Content="Redo" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource ThicknessListRow}"
                                Command="{Binding RedoCommand, Mode=OneWay}" ToolTip="Redo the layout change (Ctrl+Y)" AutomationProperties.Name="Redo layout change" />
                        <Button x:Name="RevertButton" Style="{StaticResource ThemedButton}" Content="Back to detected result" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource ThicknessListRow}"
                                Command="{Binding RevertCommand, Mode=OneWay}" ToolTip="Forget all layout changes and show the parts as the scan found them (can be undone)"
                                AutomationProperties.Name="Back to detected result" />
                    </StackPanel>
                </WrapPanel>

                <!-- Column headers over the row columns: # narrow, Part takes the free width, then Lines and Status
                     with fixed widths and an 8 px gap before each. The last column keeps the width of the list's
                     vertical scroll bar, which is always shown, so the headers stay over their columns. -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource border-brush}" BorderThickness="0,0,0,1"
                        Padding="{DynamicResource ThicknessListRow}">
                    <Grid x:Name="ContainersHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Part" FontWeight="SemiBold" />
                        <TextBlock x:Name="LinesHeader" Grid.Column="3" Text="Lines" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" />
                        <Border Grid.Column="6" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                    </Grid>
                </Border>

                <ListBox x:Name="ContainersList" ItemsSource="{Binding Containers, Mode=OneWay}"
                         SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource ContainerRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         AutomationProperties.Name="Containers">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Confidence, Mode=OneWay, StringFormat='Guess confidence: {0}'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="NumberText" Grid.Column="0" Text="{Binding Number, Mode=OneWay}" />
                                <TextBlock x:Name="PartText" Grid.Column="1" Text="{Binding Part, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Part, Mode=OneWay}" />
                                <TextBlock x:Name="LinesText" Grid.Column="3" Text="{Binding Lines, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatusText" Grid.Column="5" Text="{Binding StatusText, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource warning-brush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource error-brush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Second, muted line only for a row with an issue. -->
                                <TextBlock x:Name="IssueText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding IssueSummary, Mode=OneWay}"
                                           Foreground="{DynamicResource text-muted-brush}" FontSize="{DynamicResource font-caption}"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource HiddenWhenEmpty}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter x:Name="ListSplitter" Grid.Column="1" Width="8" AutomationProperties.Name="Resize the container list" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Details keeps about 8 text rows (tab header plus 8 x 17 px plus padding), the Preview about 6 lines plus its scroll bar. -->
                    <RowDefinition Height="2*" MinHeight="204" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!-- Details (format, delimiter, header, skip lines, reasons, checks) and Edit (the review tools) as two tabs. -->
                <TabControl x:Name="DetailsTabs" Grid.Row="0" AutomationProperties.Name="Details and edit">
                    <TabItem x:Name="DetailsTab" Header="Details" AutomationProperties.Name="Details">
                    <Border x:Name="DetailsPanel" BorderBrush="{DynamicResource border-brush}" BorderThickness="1" Padding="{DynamicResource Thickness8}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Choose a container on the left to see its details."
                                           Foreground="{DynamicResource text-muted-brush}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedContainer, Mode=OneWay}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Details, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource text-muted-brush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Reasons, Mode=OneWay}" Margin="{DynamicResource Thickness4}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource text-muted-brush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding IssueLines, Mode=OneWay}" Margin="{DynamicResource Thickness4}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    </TabItem>

                    <TabItem x:Name="EditTab" Header="Edit" AutomationProperties.Name="Edit">
                        <!-- Four compact rows that wrap when the pane is narrow; the ScrollViewer is only a safety net at the minimum size. -->
                        <ScrollViewer x:Name="EditScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <Border Padding="{DynamicResource ThicknessListRow}">
                                <StackPanel x:Name="EditPanel">
                                    <TextBlock x:Name="EditIntro" Text="Choose a part on the left to change it. Every change can be undone."
                                               ToolTip="Choose a part on the left to change it. Every change can be undone."
                                               Foreground="{DynamicResource text-muted-brush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="{DynamicResource ThicknessListRow}" />

                                    <WrapPanel x:Name="FormatRow">
                                        <TextBlock Text="Format" Style="{StaticResource EditRowLabel}" />
                                        <ComboBox x:Name="FormatBox" Width="200" Style="{StaticResource EditCombo}"
                                                  ItemsSource="{Binding FormatChoices, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedFormat, Mode=TwoWay}" IsEnabled="{Binding CanEditSelected, Mode=OneWay}"
                                                  AutomationProperties.Name="Format" />
                                        <Button x:Name="ChangeFormatButton" Style="{StaticResource EditButton}" Content="Change format"
                                                Command="{Binding ChangeFormatCommand, Mode=OneWay}" AutomationProperties.Name="Change format" />
                                    </WrapPanel>

                                    <WrapPanel x:Name="TableRow">
                                        <TextBlock Text="Delimiter" Style="{StaticResource EditRowLabel}" />
                                        <ComboBox x:Name="DelimiterBox" Width="110" Style="{StaticResource EditCombo}"
                                                  ItemsSource="{Binding DelimiterChoices, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedDelimiter, Mode=TwoWay}" IsEnabled="{Binding IsTableSelected, Mode=OneWay}"
                                                  AutomationProperties.Name="Delimiter" />
                                        <TextBlock Text="Header" Style="{StaticResource EditLabel}" />
                                        <!-- "(not set)" is drawn over the box while a table has no header choice; it is not one of the choices. -->
                                        <Grid>
                                            <ComboBox x:Name="HeaderBox" Width="90" Style="{StaticResource EditCombo}"
                                                      ItemsSource="{Binding HeaderChoices, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedHeader, Mode=TwoWay}" IsEnabled="{Binding IsTableSelected, Mode=OneWay}"
                                                      AutomationProperties.Name="Header" />
                                            <TextBlock x:Name="HeaderPlaceholder" Text="(not set)" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                       Margin="{DynamicResource ThicknessPlaceholder}" Foreground="{DynamicResource text-muted-brush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SelectedHeader, Mode=OneWay}" Value="{x:Null}" />
                                                                    <Condition Binding="{Binding IsTableSelected, Mode=OneWay}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="Skip lines" Style="{StaticResource EditLabel}" />
                                        <TextBox x:Name="SkipLinesBox" Width="48" Style="{StaticResource EditBox}"
                                                 Text="{Binding SkipLinesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTableSelected, Mode=OneWay}"
                                                 AutomationProperties.Name="Skip lines" />
                                        <Button x:Name="ApplyOptionsButton" Style="{StaticResource EditButton}" Content="Apply options"
                                                Command="{Binding ApplyOptionsCommand, Mode=OneWay}" ToolTip="Delimiter, header and skip lines apply to CSV, TSV and fixed-width tables"
                                                ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Apply table options" />
                                    </WrapPanel>

                                    <WrapPanel x:Name="NameRow">
                                        <TextBlock Text="Name" Style="{StaticResource EditRowLabel}" />
                                        <TextBox x:Name="NameBox" Width="200" Style="{StaticResource EditBox}"
                                                 Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSelected, Mode=OneWay}"
                                                 AutomationProperties.Name="Name" />
                                        <Button x:Name="RenameButton" Style="{StaticResource EditButton}" Content="Rename"
                                                Command="{Binding RenameCommand, Mode=OneWay}" AutomationProperties.Name="Rename" />
                                    </WrapPanel>

                                    <WrapPanel x:Name="SplitRow">
                                        <TextBlock Text="Split at line" Style="{StaticResource EditRowLabel}" />
                                        <TextBox x:Name="SplitLineBox" Width="64" Style="{StaticResource EditBox}"
                                                 Text="{Binding SplitLineText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSelected, Mode=OneWay}"
                                                 ToolTip="Click a line in the Preview, or type a file line number" AutomationProperties.Name="Split line number" />
                                        <Button x:Name="SplitButton" Style="{StaticResource EditButton}" Content="Split before the selected line"
                                                Command="{Binding SplitCommand, Mode=OneWay}" ToolTip="{Binding SplitToolTip, Mode=OneWay}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="Split before the selected line" />
                                        <Button x:Name="MergeButton" Style="{StaticResource EditButton}" Content="Merge with next part"
                                                Command="{Binding MergeCommand, Mode=OneWay}" AutomationProperties.Name="Merge with next part" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <GridSplitter x:Name="DetailsSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <!-- Preview: one row per line, starting with its file line number, no wrapping. A click chooses the split line. -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewNote, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                    <ListBox x:Name="PreviewBox" ItemsSource="{Binding PreviewRows, Mode=OneWay}"
                             SelectedItem="{Binding SelectedPreviewLine, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PreviewRow}"
                             FontFamily="{DynamicResource font-data}"
                             FontSize="{DynamicResource font-body}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Preview">
                        <!-- Ctrl+C and "Copy line" copy the selected line's text without its line number (a right-click selects the line first). -->
                        <ListBox.InputBindings>
                            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyPreviewLineCommand, Mode=OneWay}" />
                        </ListBox.InputBindings>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="PreviewMenu" AutomationProperties.Name="Preview line">
                                <MenuItem x:Name="CopyLineItem" Header="Copy line" InputGestureText="Ctrl+C"
                                          Command="{Binding CopyPreviewLineCommand, Mode=OneWay}" AutomationProperties.Name="Copy line" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ===== Bottom: totals, messages, encoding notice, buttons ===== -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Style="{StaticResource ThemedButton}" Content="Save settings" MinWidth="110" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                        Command="{Binding SaveCommand, Mode=OneWay}" />
                <Button x:Name="CloseButton" Style="{StaticResource ThemedButton}" Content="Close" MinWidth="110" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                        Command="{Binding CloseCommand, Mode=OneWay}" />
            </StackPanel>
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="LayoutText" DockPanel.Dock="Right" Text="{Binding LayoutText, Mode=OneWay}" Foreground="{DynamicResource text-muted-brush}" Margin="{DynamicResource Thickness4}" />
                    <TextBlock x:Name="TotalsText" Text="{Binding TotalsText, Mode=OneWay}" FontWeight="SemiBold" Margin="{DynamicResource Thickness4}" />
                </DockPanel>
                <TextBlock x:Name="StatusLine" Text="{Binding EditStatus, Mode=OneWay}" TextWrapping="Wrap" Margin="{DynamicResource Thickness4}"
                           Style="{StaticResource HiddenWhenEmpty}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="LineageNoteText" Text="{Binding LineageNote, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource text-muted-brush}"
                           Margin="{DynamicResource Thickness4}" Style="{StaticResource HiddenWhenEmpty}" />
                <Border Tag="{Binding Message, Mode=OneWay}" Style="{StaticResource HiddenWhenNull}"
                        BorderBrush="{DynamicResource border-brush}" BorderThickness="1"
                        Background="{DynamicResource surface-alt-brush}" Padding="{DynamicResource Thickness8}" Margin="{DynamicResource Thickness4}">
                    <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
                </Border>
                <Border Tag="{Binding EncodingNotice, Mode=OneWay}" Style="{StaticResource HiddenWhenNull}"
                        BorderBrush="{DynamicResource warning-brush}" BorderThickness="1"
                        Background="{DynamicResource surface-alt-brush}" Padding="{DynamicResource Thickness8}" Margin="{DynamicResource Thickness4}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Encoding: " FontWeight="SemiBold" /><Run Text="{Binding EncodingNotice, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
