<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EtlDesigner.UI.Converters"
                    xmlns:vm="clr-namespace:EtlDesigner.UI.ViewModels">

    <!-- State to Color Converter for node background -->
    <local:NodeStateToColorConverter x:Key="NodeStateToColorConverter" />

    <!-- Pending connection stroke converter (green valid, red invalid) -->
    <local:PendingConnectionStrokeConverter x:Key="PendingConnectionStrokeConverter" />

    <!-- Node Template for NodeViewModel using Border (WPF-only for now) -->
    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
        <Border Background="{Binding State, Converter={StaticResource NodeStateToColorConverter}}"
                BorderBrush="#333"
                BorderThickness="2"
                CornerRadius="4"
                Width="160"
                Padding="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Vertical">
                <!-- Title header -->
                <TextBlock Text="{Binding Title}"
                          FontWeight="Bold"
                          Margin="0,0,0,8"
                          TextAlignment="Center"
                          Foreground="Black"
                          FontSize="11" />

                <!-- Input connectors -->
                <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                            <TextBlock Text="{Binding Name}"
                                      FontSize="9"
                                      Foreground="DarkGreen"
                                      Margin="0,2,0,2"
                                      ToolTip="{Binding Kind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator if both inputs and outputs exist -->
                <Separator Margin="0,4,0,4" Background="#CCC" Height="1" />

                <!-- Output connectors -->
                <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                            <TextBlock Text="{Binding Name}"
                                      FontSize="9"
                                      Foreground="DarkRed"
                                      Margin="0,2,0,2"
                                      ToolTip="{Binding Kind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer: State and RowCount -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Background="#E0E0E0">
                    <TextBlock Text="{Binding State}"
                              FontSize="8"
                              Margin="2,1,2,1"
                              Foreground="#333" />
                    <TextBlock Text="{Binding RowCount, StringFormat='rows: {0}'}"
                              FontSize="8"
                              Margin="2,1,2,1"
                              Foreground="#333" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
