<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EtlDesigner.UI.Converters"
                    xmlns:vm="clr-namespace:EtlDesigner.UI.ViewModels">

    <!-- State to Color Converter for node background -->
    <local:NodeStateToColorConverter x:Key="NodeStateToColorConverter" />

    <!-- Pending connection stroke converter (green valid, red invalid) -->
    <local:PendingConnectionStrokeConverter x:Key="PendingConnectionStrokeConverter" />

    <!-- Node Template for NodeViewModel using Border (WPF-only for now) -->
    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
        <Border Background="{Binding State, Converter={StaticResource NodeStateToColorConverter}}"
                BorderBrush="{DynamicResource border-brush}"
                BorderThickness="2"
                CornerRadius="4"
                Width="160"
                Padding="8">
            <Border.InputBindings>
                <!-- File intake: a double-click opens Intake Studio. Null for the other nodes. [U: Nodify may take the double-click first] -->
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DoubleClickCommand, Mode=OneWay}" />
            </Border.InputBindings>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Vertical">
                <!-- Title header -->
                <TextBlock Text="{Binding Title}"
                          FontWeight="Bold"
                          Margin="0,0,0,8"
                          TextAlignment="Center"
                          Foreground="{DynamicResource text-brush}"
                          FontFamily="{DynamicResource font-text}"
                          FontSize="{DynamicResource font-caption}" />

                <!-- File intake: subtitle, file name and scan totals, and the button that opens Intake Studio.
                     Each part is hidden when the node has no value for it. -->
                <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="{DynamicResource Thickness4}"
                           Foreground="{DynamicResource text-muted-brush}"
                           FontFamily="{DynamicResource font-text}"
                           FontSize="{DynamicResource font-caption}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Subtitle, Mode=OneWay}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding CanvasNote, Mode=OneWay}"
                           ToolTip="{Binding CanvasNoteToolTip, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="{DynamicResource Thickness4}"
                           Foreground="{DynamicResource text-brush}"
                           FontFamily="{DynamicResource font-text}"
                           FontSize="{DynamicResource font-caption}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanvasNote, Mode=OneWay}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="Open Intake Studio"
                        Command="{Binding ConfigureCommand, Mode=OneWay}"
                        Margin="{DynamicResource Thickness4}"
                        Padding="{DynamicResource Thickness4}"
                        FontFamily="{DynamicResource font-text}"
                        FontSize="{DynamicResource font-caption}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeType, Mode=OneWay}" Value="FileIntake">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Input connectors -->
                <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                            <TextBlock Text="{Binding Name}"
                                      FontSize="{DynamicResource font-caption}"
                                      Foreground="{DynamicResource success-brush}"
                                      FontFamily="{DynamicResource font-text}"
                                      Margin="0,2,0,2"
                                      ToolTip="{Binding Kind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator if both inputs and outputs exist -->
                <Separator Margin="0,4,0,4" Background="{DynamicResource border-brush}" Height="1" />

                <!-- Output connectors -->
                <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                            <TextBlock Text="{Binding Name}"
                                      FontSize="{DynamicResource font-caption}"
                                      Foreground="{DynamicResource error-brush}"
                                      FontFamily="{DynamicResource font-text}"
                                      Margin="0,2,0,2"
                                      ToolTip="{Binding Kind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer: State and RowCount -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Background="{DynamicResource surface-alt-brush}">
                    <TextBlock Text="{Binding State}"
                              FontSize="{DynamicResource font-caption}"
                              Margin="2,1,2,1"
                              Foreground="{DynamicResource text-brush}"
                              FontFamily="{DynamicResource font-text}" />
                    <TextBlock Text="{Binding RowCount, StringFormat='rows: {0}'}"
                              FontSize="{DynamicResource font-caption}"
                              Margin="2,1,2,1"
                              Foreground="{DynamicResource text-brush}"
                              FontFamily="{DynamicResource font-text}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
