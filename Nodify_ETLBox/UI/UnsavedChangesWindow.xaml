<Window x:Class="Nodify_ETLBox.UI.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="{DynamicResource Thickness16}">
        <StackPanel>
            <TextBlock Text="{Binding Message, Mode=OneWay}"
                       FontSize="{DynamicResource font-title}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="{DynamicResource Thickness4}" />
            <TextBlock Text="Your changes are lost if you do not save them."
                       Foreground="{DynamicResource text-muted-brush}"
                       TextWrapping="Wrap"
                       Margin="{DynamicResource Thickness4}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Thickness8}">
                <Button Content="Save" Width="100" IsDefault="True" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}"
                        Command="{Binding SaveCommand, Mode=OneWay}" />
                <Button Content="Don't save" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}"
                        Command="{Binding DontSaveCommand, Mode=OneWay}" />
                <Button Content="Cancel" Width="100" IsCancel="True" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}"
                        Command="{Binding CancelCommand, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
