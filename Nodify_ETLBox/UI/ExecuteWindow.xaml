<Window x:Class="Nodify_ETLBox.UI.ExecuteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execute"
        Width="1000"
        Height="700"
        MinWidth="800"
        MinHeight="560"
        ResizeMode="CanResize"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- A panel that shows only while its Tag (a message) is set. -->
            <Style x:Key="MessagePanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource surface-alt-brush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource error-brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="{DynamicResource Thickness8}" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Shows only while its Tag (a text) is set, without the error border. -->
            <Style x:Key="TagPanel" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource text-muted-brush}" />
                <Setter Property="Margin" Value="{DynamicResource Thickness4}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{DynamicResource Thickness16}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- File to run -->
        <DockPanel Grid.Row="0" Margin="{DynamicResource Thickness4}">
            <TextBlock DockPanel.Dock="Left" Text="File to run" FontWeight="SemiBold" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
            <Button DockPanel.Dock="Right" Content="Run" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}" Command="{Binding RunCommand}" />
            <Button DockPanel.Dock="Right" Content="Browse..." Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}" Command="{Binding BrowseCommand}" />
            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource font-data}" VerticalContentAlignment="Center" Margin="{DynamicResource Thickness4}" />
        </DockPanel>

        <!-- Progress while running -->
        <Border Grid.Row="1" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" Background="{DynamicResource surface-alt-brush}"
                Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding ShowCancel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="220" Margin="{DynamicResource Thickness8}" />
                <TextBlock Text="{Binding CountsText, Mode=OneWay}" VerticalAlignment="Center" Margin="{DynamicResource Thickness4}" />
            </DockPanel>
        </Border>

        <!-- A message that stopped the run, including the licence limit -->
        <Border Grid.Row="2" Style="{StaticResource MessagePanel}" Tag="{Binding Message, Mode=OneWay}">
            <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
        </Border>

        <!-- Summary -->
        <StackPanel Grid.Row="3" Margin="{DynamicResource Thickness4}">
            <TextBlock Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" Margin="{DynamicResource Thickness4}" />
            <Border Style="{StaticResource TagPanel}" Tag="{Binding CancelledText, Mode=OneWay}">
                <TextBlock Text="{Binding CancelledText, Mode=OneWay}" Style="{StaticResource MutedText}" />
            </Border>
            <!-- A CSV part run: which file, template and part were read. -->
            <Border Style="{StaticResource TagPanel}" Tag="{Binding PartFactsText, Mode=OneWay}">
                <TextBlock Text="{Binding PartFactsText, Mode=OneWay}" Style="{StaticResource MutedText}" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="4" Margin="{DynamicResource Thickness4}">
            <TabItem Header="Output">
                <DockPanel Margin="{DynamicResource Thickness8}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OutputNote, Mode=OneWay}" Style="{StaticResource MutedText}" />
                    <DataGrid ItemsSource="{Binding OutputRowsView, Mode=OneWay}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              FontFamily="{DynamicResource font-data}"
                              Margin="{DynamicResource Thickness4}" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Rejects">
                <DockPanel Margin="{DynamicResource Thickness8}">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Copy rejects" Width="120" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness4}" Command="{Binding CopyRejectsCommand}" />
                    <TextBlock DockPanel.Dock="Top" Text="No rejected rows." Style="{StaticResource MutedText}"
                               Visibility="{Binding ShowNoRejects, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Rejects, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              FontFamily="{DynamicResource font-data}" Margin="{DynamicResource Thickness4}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Record" Binding="{Binding RecordNumber, Mode=OneWay}" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Flagged">
                <DockPanel Margin="{DynamicResource Thickness8}">
                    <TextBlock DockPanel.Dock="Top" Text="No flagged rows." Style="{StaticResource MutedText}"
                               Visibility="{Binding ShowNoFlagged, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Flagged, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              FontFamily="{DynamicResource font-data}" Margin="{DynamicResource Thickness4}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Record" Binding="{Binding RecordNumber, Mode=OneWay}" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Thickness8}">
            <Button Content="Close" Width="100" Margin="{DynamicResource Thickness4}" Padding="{DynamicResource Thickness8}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
