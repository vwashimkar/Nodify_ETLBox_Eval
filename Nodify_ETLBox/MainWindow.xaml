<Window x:Class="Nodify_ETLBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:vm="clr-namespace:EtlDesigner.UI.ViewModels"
        xmlns:conv="clr-namespace:EtlDesigner.UI.Converters"
        xmlns:controls="clr-namespace:EtlDesigner.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Height="700"
        Width="1200"
        Background="{DynamicResource surface-brush}"
        Foreground="{DynamicResource text-brush}"
        FontFamily="{DynamicResource font-text}"
        FontSize="{DynamicResource font-body}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:PendingConnectionStrokeConverter x:Key="PendingStroke" />
        <SolidColorBrush x:Key="GraphConnectionBrush" Color="{DynamicResource accent}" />
        <SolidColorBrush x:Key="NodeInput.BorderBrush" Color="{DynamicResource accent}" />
        <SolidColorBrush x:Key="NodeOutput.BorderBrush" Color="{DynamicResource accent}" />

        <!-- A node footer line that is hidden while it has no text. -->
        <Style x:Key="NodeNoteText" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Node footer lines that do not apply to a File intake node ("Idle | rows: 0", "Configured"). -->
        <Style x:Key="HiddenForFileIntake" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeType, Mode=OneWay}" Value="FileIntake">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Settings editors, chosen by SettingViewModel.Kind ===== -->
        <DataTemplate x:Key="TextSettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate x:Key="SummarySettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <TextBlock Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource text-brush}" />
        </DataTemplate>
        <DataTemplate x:Key="NumberSettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate x:Key="CheckBoxSettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate x:Key="FilePathSettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="..."
                        Width="28"
                        Margin="4,0,0,0"
                        Command="{Binding BrowseCommand}" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ComboSettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <ComboBox IsEditable="True"
                      ItemsSource="{Binding ComboBoxItems}"
                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <!-- A drop-down whose disabled entries show but cannot be picked (SettingKind.Choice) -->
        <DataTemplate x:Key="ChoiceSettingTemplate" DataType="{x:Type vm:SettingViewModel}">
            <ComboBox ItemsSource="{Binding Choices, Mode=OneWay}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Value, Mode=TwoWay}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled, Mode=OneWay}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </DataTemplate>

        <!-- One row in the settings panel: label, red * when required and empty, editor -->
        <DataTemplate x:Key="SettingRowTemplate" DataType="{x:Type vm:SettingViewModel}">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text=" *"
                               Foreground="{DynamicResource error-brush}"
                               FontWeight="Bold"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ContentControl Content="{Binding}" Margin="0,4,0,0">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TextSettingTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="FilePath">
                                    <Setter Property="ContentTemplate" Value="{StaticResource FilePathSettingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ComboBox">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ComboSettingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="CheckBox">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CheckBoxSettingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Number">
                                    <Setter Property="ContentTemplate" Value="{StaticResource NumberSettingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Choice">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ChoiceSettingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Summary">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SummarySettingTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <TextBlock Text="{Binding InfoMessage}"
                           Foreground="{DynamicResource text-muted-brush}"
                           FontSize="{DynamicResource font-caption}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InfoMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InfoMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding WarningMessage}"
                           Foreground="{DynamicResource warning-brush}"
                           FontSize="{DynamicResource font-caption}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WarningMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WarningMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ===== Toolbar ===== -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Width="50" Command="{Binding NewProjectCommand}" ToolTip="New project (Ctrl+N)" />
            <Button Content="Open" Width="50" Command="{Binding OpenProjectCommand}" ToolTip="Open a project (Ctrl+O)" />
            <Button Content="Save" Width="50" Command="{Binding SaveProjectCommand}" ToolTip="Save the project (Ctrl+S)" />
            <Button Content="Save As" Width="60" Command="{Binding SaveProjectAsCommand}" ToolTip="Save the project under a new name (Ctrl+Shift+S)" />
            <ToggleButton x:Name="RecentToggle" Content="Recent" Width="60"
                          IsChecked="{Binding IsRecentOpen, Mode=TwoWay}"
                          ToolTip="The last five projects" />
            <Popup IsOpen="{Binding IsRecentOpen, Mode=TwoWay}"
                   StaysOpen="False"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=RecentToggle}">
                <Border Background="{DynamicResource surface-brush}"
                        BorderBrush="{DynamicResource border-brush}"
                        BorderThickness="1"
                        Padding="{DynamicResource Thickness8}"
                        MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="No recent projects."
                                   Foreground="{DynamicResource text-muted-brush}"
                                   Visibility="{Binding HasNoRecentProjects, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding RecentProjects, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentProjectViewModel}">
                                    <DockPanel Margin="{DynamicResource Thickness4}">
                                        <Button DockPanel.Dock="Right" Content="Remove"
                                                Margin="{DynamicResource Thickness4}"
                                                Padding="{DynamicResource Thickness4}"
                                                Command="{Binding RemoveCommand, Mode=OneWay}" />
                                        <TextBlock DockPanel.Dock="Right" Text="not found"
                                                   VerticalAlignment="Center"
                                                   Margin="{DynamicResource Thickness4}"
                                                   Foreground="{DynamicResource text-muted-brush}"
                                                   Visibility="{Binding IsMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{Binding DisplayName, Mode=OneWay}"
                                                ToolTip="{Binding Path, Mode=OneWay}"
                                                ToolTipService.ShowOnDisabled="True"
                                                HorizontalContentAlignment="Left"
                                                Margin="{DynamicResource Thickness4}"
                                                Padding="{DynamicResource Thickness4}"
                                                Command="{Binding OpenCommand, Mode=OneWay}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
            <Separator />
            <Button Content="Run" Width="60" Command="{Binding RunCommand}" />
            <Button Content="Execute" Width="70" Command="{Binding ExecuteCommand}"
                    ToolTip="{Binding ExecuteHint, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <Button Content="Generate DLL" Width="100" Command="{Binding GenerateDllCommand}"
                    ToolTip="{Binding GenerateDllHint, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <Button Content="Delete" Width="60" Command="{Binding Editor.DeleteSelectedCommand}" />
            <Separator />
            <Button Content="Sample" Width="60" Command="{Binding Editor.LoadSampleGraphCommand}" />
            <Separator />
            <Button Content="Spike" Width="60" Click="Spike_Click" />
            <Separator />
            <Button Content="Run all tests" Width="100" Click="RunAllTests_Click" />
            <Separator />
            <Label Content="Theme" />
            <ComboBox x:Name="ThemeSelector"
                      Width="100"
                      SelectedIndex="0"
                      SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <!-- ===== Left: palette (drag onto the editor, or click to add at a default spot) ===== -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="6">
                <TextBlock Text="Node types" FontWeight="Bold" Margin="0,0,0,8" />
                <Button Content="CsvSource (old)" Tag="CsvSource" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="CsvFile" Tag="CsvFile" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="FilterByCountry" Tag="FilterByCountry" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="ToJson" Tag="ToJson" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="ParseJson" Tag="ParseJson" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="ResultJson" Tag="ResultJson" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="ParseValue" Tag="ParseValue" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="DotNetObject" Tag="DotNetObject" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <TextBlock Text="Intake" FontWeight="Bold" Margin="0,8,0,8" />
                <Button Content="File intake" Tag="FileIntake" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
                <Button Content="CSV part" Tag="CsvPart" Margin="0,2" Padding="4"
                        Click="PaletteButton_Click"
                        PreviewMouseLeftButtonDown="PaletteButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PaletteButton_PreviewMouseMove" />
            </StackPanel>

            <!-- ===== Center: Nodify editor. NOT wrapped in a ScrollViewer: Nodify owns pan/zoom. ===== -->
            <nodify:NodifyEditor x:Name="EditorControl"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Background="{DynamicResource canvas-brush}"
                                 AllowDrop="True"
                                 Drop="EditorControl_Drop"
                                 ItemsSource="{Binding Editor.Nodes}"
                                 SelectedItems="{Binding Editor.SelectedNodes}"
                                 Connections="{Binding Editor.Connections}"
                                 PendingConnection="{Binding Editor.PendingConnection}"
                                 ConnectionStartedCommand="{Binding Editor.StartConnectionCommand}"
                                 ConnectionCompletedCommand="{Binding Editor.CreateConnectionCommand}"
                                 DisconnectConnectorCommand="{Binding Editor.DisconnectConnectorCommand}"
                                 ViewportZoom="{Binding Editor.ViewportZoom, Mode=TwoWay}"
                                 ViewportLocation="{Binding Editor.ViewportLocation, Mode=TwoWay}">

                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding Editor.DeleteSelectedCommand}" />
                </nodify:NodifyEditor.InputBindings>

                <!-- Node position, two-way, so dragging updates the ViewModel -->
                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <!-- Established connection: curved line with an arrowhead at the target -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Target="{Binding Target.Anchor}"
                                           ArrowEnds="End"
                                           Stroke="{StaticResource GraphConnectionBrush}"
                                           StrokeThickness="2" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- Connection being dragged: green when valid, red when not -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                        <nodify:PendingConnection Source="{Binding Source, Mode=OneWayToSource}"
                                                  Target="{Binding Target, Mode=OneWayToSource}"
                                                  PreviewTarget="{Binding PreviewTarget, Mode=OneWayToSource}"
                                                  EnablePreview="True"
                                                  Stroke="{Binding IsValid, Converter={StaticResource PendingStroke}}" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>

                <!-- A node: title, typed input/output connectors, state footer -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                        <!-- A double-click opens the node's dialog (File intake: Intake Studio); DoubleClickCommand is null for the others. -->
                        <nodify:Node Header="{Binding Title}"
                                     controls:NodeDoubleClick.Command="{Binding DoubleClickCommand, Mode=OneWay}"
                                     Input="{Binding Inputs}"
                                     Output="{Binding Outputs}"
                                     Background="{DynamicResource NodeBodyBackground}"
                                     ContentBrush="{DynamicResource NodeBodyBackground}"
                                     HeaderBrush="{DynamicResource NodeHeaderBackground}"
                                     Foreground="{DynamicResource NodeBodyForeground}">

                            <!-- Footer colour by state, from theme tokens so it follows a theme switch -->
                            <nodify:Node.Style>
                                <Style TargetType="{x:Type nodify:Node}">
                                    <Setter Property="FooterBrush" Value="{DynamicResource NodeStateIdleBackground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="FooterBrush" Value="{DynamicResource NodeStateRunningBackground}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                            <Setter Property="FooterBrush" Value="{DynamicResource NodeStateSucceededBackground}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="FooterBrush" Value="{DynamicResource NodeStateFailedBackground}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="NotRun">
                                            <Setter Property="FooterBrush" Value="{DynamicResource NodeStateNotRunBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </nodify:Node.Style>

                            <nodify:Node.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NodeHeaderForeground}" />
                                </DataTemplate>
                            </nodify:Node.HeaderTemplate>

                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                    <nodify:NodeInput Header="{Binding Name}"
                                                      IsConnected="{Binding IsConnected}"
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                      Background="{StaticResource GraphConnectionBrush}"
                                                      Foreground="{DynamicResource text-brush}"
                                                      BorderBrush="{StaticResource GraphConnectionBrush}"
                                                      ToolTip="{Binding Kind}" />
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>

                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectorViewModel}">
                                    <nodify:NodeOutput Header="{Binding Name}"
                                                        IsConnected="{Binding IsConnected}"
                                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                        Background="{StaticResource GraphConnectionBrush}"
                                                        Foreground="{DynamicResource text-brush}"
                                                        BorderBrush="{StaticResource GraphConnectionBrush}"
                                                        ToolTip="{Binding Kind}" />
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>

                            <nodify:Node.Footer>
                                <StackPanel Margin="4,2">
                                    <!-- File intake: subtitle, file name (full path in the tooltip) and, after a scan, the totals.
                                         Empty for the other nodes, so hidden. -->
                                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-muted-brush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="170"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource NodeNoteText}" />
                                    <TextBlock Text="{Binding IntakeFileText, Mode=OneWay}"
                                               ToolTip="{Binding CanvasNoteToolTip, Mode=OneWay}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-brush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="170"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource NodeNoteText}" />
                                    <TextBlock Text="{Binding IntakeSummary, Mode=OneWay}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-brush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="170"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource NodeNoteText}" />
                                    <TextBlock Text="{Binding IntakeLayoutText, Mode=OneWay}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-muted-brush}"
                                               MaxWidth="170"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource NodeNoteText}" />
                                    <!-- CSV part: part number, template, delimiter and columns, then the status line. Hidden for the others. -->
                                    <TextBlock Text="{Binding CsvPartText, Mode=OneWay}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-brush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="170"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource NodeNoteText}" />
                                    <TextBlock Text="{Binding CsvPartStatus, Mode=OneWay}"
                                               ToolTip="{Binding CsvPartStatus, Mode=OneWay}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-muted-brush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="170"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource NodeNoteText}" />
                                    <StackPanel Orientation="Horizontal" Style="{StaticResource HiddenForFileIntake}">
                                        <TextBlock Text="{Binding State}" FontSize="{DynamicResource font-caption}" Foreground="{DynamicResource text-brush}" />
                                        <TextBlock Text=" | rows: " FontSize="{DynamicResource font-caption}" Foreground="{DynamicResource text-brush}" />
                                        <TextBlock Text="{Binding RowCount}" FontSize="{DynamicResource font-caption}" Foreground="{DynamicResource text-brush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConfigurationStatus}"
                                               Style="{StaticResource HiddenForFileIntake}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-muted-brush}"
                                               Margin="0,2,0,0" />
                                    <ProgressBar IsIndeterminate="True"
                                                 Height="{DynamicResource spacing-4}"
                                                 Margin="0,2,0,0"
                                                 ToolTip="Reading the columns of the file"
                                                 Visibility="{Binding IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               ToolTip="{Binding ErrorDetail}"
                                               FontSize="{DynamicResource font-caption}"
                                               Foreground="{DynamicResource text-muted-brush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               MaxWidth="170"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </nodify:Node.Footer>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>
            </nodify:NodifyEditor>

            <!-- ===== Right: settings of the single selected node (no code-behind) ===== -->
            <Border Grid.Row="0" Grid.Column="2" Padding="8" BorderBrush="{DynamicResource border-brush}" BorderThickness="1,0,0,0" Background="{DynamicResource surface-alt-brush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Settings" FontWeight="Bold" Margin="0,0,0,8" />
                    <Grid>
                        <TextBlock Text="Select a node" Foreground="{DynamicResource text-muted-brush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.SelectedNode}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- File intake: opens Intake Studio, the same command as a double-click on the node. -->
                                <Button x:Name="OpenIntakeStudioButton"
                                        Content="Open Intake Studio"
                                        MinWidth="120"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8"
                                        Padding="8,2"
                                        Command="{Binding Editor.SelectedNode.ConfigureCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ThemedButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.SelectedNode.NodeType}" Value="FileIntake">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- CSV part: read-only in G6c (the part is chosen in Intake Studio in G6d). Hidden for the others. -->
                                <TextBlock Text="{Binding Editor.SelectedNode.CsvPartText, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource text-brush}"
                                           Style="{StaticResource NodeNoteText}" />
                                <TextBlock Text="{Binding Editor.SelectedNode.CsvPartStatus, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource text-muted-brush}"
                                           Style="{StaticResource NodeNoteText}" />
                                <ItemsControl ItemsSource="{Binding Editor.SelectedNode.Settings}"
                                              ItemTemplate="{StaticResource SettingRowTemplate}" />
                                <Button Content="Load preview"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Command="{Binding Editor.SelectedNode.LoadPreviewCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ThemedButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.SelectedNode.NodeType}" Value="CsvFile">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Configure..."
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Command="{Binding Editor.SelectedNode.ConfigureCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ThemedButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.SelectedNode.NodeType}" Value="ParseValue">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== Bottom: issues and the two JSON outputs ===== -->
            <TabControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                <TabItem Header="Issues">
                    <ListBox ItemsSource="{Binding Editor.Issues}" Margin="4" />
                </TabItem>
                <TabItem Header="Filtered JSON">
                    <TextBox Text="{Binding FilteredJsonOutput, Mode=OneWay}"
                             Margin="4"
                             IsReadOnly="True"
                             FontFamily="{DynamicResource font-data}"
                             FontSize="{DynamicResource font-body}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="Parsed JSON">
                    <TextBox Text="{Binding ParsedJsonOutput, Mode=OneWay}"
                             Margin="4"
                             IsReadOnly="True"
                             FontFamily="{DynamicResource font-data}"
                             FontSize="{DynamicResource font-body}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
