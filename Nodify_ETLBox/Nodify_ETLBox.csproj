<Project Sdk="Microsoft.NET.Sdk">
	

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>EtlDesigner</RootNamespace>
		<LangVersion>latest</LangVersion>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	

	<ItemGroup>
	  <Compile Remove=".github\**" />
	  <EmbeddedResource Remove=".github\**" />
	  <None Remove=".github\**" />
	  <Page Remove=".github\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ETLBox" Version="3.11.1" />
		<PackageReference Include="ETLBox.Csv" Version="3.11.1" />
		<PackageReference Include="ETLBox.Json" Version="3.11.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageReference Include="Nodify" Version="7.3.0" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="reference\**" />
		<Page Remove="reference\**" />
		<ApplicationDefinition Remove="reference\**" />
		<EmbeddedResource Remove="reference\**" />
		<None Remove="reference\**" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Engine\PipelineCore.cs" />
	  <EmbeddedResource Include="Engine\PipelineSettings.cs" />
	  <EmbeddedResource Include="Engine\PipelineExecutionStats.cs" />
	  <EmbeddedResource Include="Engine\PipelineFailureNode.cs" />
	  <EmbeddedResource Include="Engine\CountryListResult.cs" />
	</ItemGroup>

	<!-- Engine files embedded in a CsvFile -> ParseValue -> DotNetObject DLL (CsvPipelineDllGenerator.SourceFiles). -->
	<ItemGroup>
	  <EmbeddedResource Include="Engine\Csv\CsvFileSettings.cs" />
	  <EmbeddedResource Include="Engine\Csv\CsvColumnSelection.cs" />
	  <EmbeddedResource Include="Engine\Csv\CsvErrorText.cs" />
	  <EmbeddedResource Include="Engine\Csv\CsvRecordReader.cs" />
	  <EmbeddedResource Include="Engine\Csv\CsvFileValidator.cs" />
	  <EmbeddedResource Include="Engine\Parsing\ParseValueSettings.cs" />
	  <EmbeddedResource Include="Engine\Parsing\CompositeCellParser.cs" />
	  <EmbeddedResource Include="Engine\Parsing\ParseValueTransform.cs" />
	  <EmbeddedResource Include="Engine\Parsing\ParseValueValidator.cs" />
	  <EmbeddedResource Include="Engine\Pipeline\SettingsJson.cs" />
	  <EmbeddedResource Include="Engine\Pipeline\OutputSettings.cs" />
	  <EmbeddedResource Include="Engine\Pipeline\PipelineDefinition.cs" />
	  <EmbeddedResource Include="Engine\Pipeline\PipelineRunner.cs" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="Nodify_ETLBox.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="SampleData\employee_list.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
		<None Update="SampleData\TestData\**" CopyToOutputDirectory="PreserveNewest" />
		<None Update="SampleData\Projects\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="Exists('etlbox.lic')">
		<None Update="etlbox.lic" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
